# PyTorch 2.6+ compatibility shim: eval_at_epoch and the retrain pipeline
# both call torch.load without weights_only=False.
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# Deterministic cuBLAS ops (required to reproduce exact MAP numbers).
CUBLAS_WORKSPACE_CONFIG=":4096:8"

# Optional: your Weights & Biases API key, if you want to log retraining runs.
WANDB_API_KEY=

# Optional: NCCL tuning for multi-GPU retrain. See docs/retraining.md.
# NCCL_ALGO=Ring
# NCCL_PROTO=Simple
# NCCL_NCHANNELS=2
